# ═══════════════════════════════════════════════════════════════
#  Fahrtenbuch Bot — Environment Configuration
#  Скопіюйте як .env та заповніть значення
# ═══════════════════════════════════════════════════════════════

# ── Telegram ────────────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here

# Webhook (залиште порожнім для polling / локальної розробки)
# BOT_WEBHOOK_URL=https://your-domain.com
# WEBHOOK_PORT=8443

# ── База даних ──────────────────────────────────────────────────
# SQLite (розробка)
DATABASE_URL=sqlite+aiosqlite:///./fahrtenbuch.db

# PostgreSQL (продакшн)
# DATABASE_URL=postgresql+asyncpg://fahrt_user:password@postgres:5432/fahrtenbuch
# POSTGRES_PASSWORD=your_strong_password_here

# ── Геокодинг ───────────────────────────────────────────────────
# Порожньо = Nominatim/OpenStreetMap (безкоштовно, rate-limited)
# Або вставте Google Maps API Key для кращої якості
GOOGLE_MAPS_API_KEY=

# ── Трекінг ─────────────────────────────────────────────────────
GEOFENCE_RADIUS_METERS=100

# ── Часовий пояс ────────────────────────────────────────────────
TIMEZONE=Europe/Berlin

# ── Адміністратор ───────────────────────────────────────────────
# ADMIN_TELEGRAM_ID=123456789

# ── Telegram Storage Bot ────────────────────────────────────────
# Опціонально: другий Telegram-бот/приватний канал для backup-копій БД
# STORAGE_BOT_TOKEN=your_storage_bot_token_here
# STORAGE_CHAT_ID=-1001234567890

# ── AI / OCR чеків ────────────────────────────────────────────
# Необхідно для автоматичного розпізнавання фото чеків
# Отримайте на console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# ── Sentry (моніторинг помилок) ─────────────────────────────────
# SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0

# ── Логування ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# ── Середовище ──────────────────────────────────────────────────
# ENVIRONMENT=production
